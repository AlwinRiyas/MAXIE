.gitignore
__pycache__/
*.pyc

venv/
.env

voice.wav
barge_in.wav
*.wav

.cache/

*.log
*.log.*
Logs/*.log*

.idea/

.vscode/

build/

dist/

*.spec

*.zip

# Android (build artifacts — source lives in Android/)
Android/.gradle/
Android/.idea/
Android/local.properties
Android/**/build/

# Downloaded neural TTS models (large binaries)
Config/tts_models/

# Live user configuration — may contain a remote_server.token.
# These are created automatically by Config/config.py on first run.
# Commit Config/*.example.json instead, never the live files.
Config/*.json
!Config/*.example.json

Memory/memory.json
Memory/maxie_memory.db*
Memory/todos.json
Logs/screenshot.png

# Key material — MAXIE has no reason to hold any, so none may be committed.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.keystore

# Memory/ holds source (memory_database.py) next to user data
# (maxie_memory.db, memory.json). Only the data is ignored: a committed
# SQLite store carries every fact the assistant ever wrote down.
Memory/*.db
Memory/*.db-wal
Memory/*.db-shm
Memory/*.sqlite*
Config/home_devices.json
